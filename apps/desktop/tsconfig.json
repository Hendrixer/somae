{
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "strict": true, "allowJs": true, "noEmit": true,
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "esModuleInterop": true,
    "skipLibCheck": true
