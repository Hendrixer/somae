{
  "name": "somae",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "prototypes/*"
  ],
  "scripts": {
    "dev": "node prototypes/desktop/server.mjs",
    "prototype": "node prototypes/desktop/server.mjs",
    "check": "node scripts/verify.mjs",
    "verify": "node scripts/verify.mjs",
    "check:domain": "node packages/domain/validate.mjs && node --test packages/domain/*.test.js",
    "check:design": "node packages/design-system/build.mjs && node packages/design-system/validate.mjs",
    "check:api": "node scripts/check-app.mjs api",
    "check:desktop": "node scripts/check-app.mjs desktop",
    "check:website": "node scripts/check-app.mjs website",
    "desktop": "bun run --cwd apps/desktop dev",
    "setup:desktop": "cd apps/desktop && bunx electrobun prepare --env=dev",
    "channel:proof": "node scripts/channel-proof.mjs",
    "map": "node scripts/check-boundaries.mjs",
    "context": "node scripts/context.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.8"
}
