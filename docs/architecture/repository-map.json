{
  "schema_version": 1,
  "id": "somae.repository",
  "audience": "development_agents",
  "purpose": "Help coding agents navigate and safely change the Somae repository; this is not a routing/knowledge system for product-connected agents.",
  "developer_entry_points": [
    "AGENTS.md",
    "README.md",
    "docs/WORKFLOW.md"
  ],
  "business_model": "packages/domain/ontology.json",
  "nodes": [
    {
      "id": "api",
      "kind": "app",
      "path": "apps/api",
      "status": "test-version",
      "description": "Private Cloudflare Worker API, SQLite-backed per-person Durable Object and R2 originals.",
      "entry_points": [
        "apps/api/src/worker.ts",
        "apps/api/wrangler.jsonc",
        "apps/api/test/worker.test.ts"
      ],
      "guide": "apps/api/README.md",
      "package_name": "@somae/api"
    },
    {
      "id": "desktop",
      "kind": "app",
      "path": "apps/desktop",
      "status": "test-version",
      "description": "Electrobun/Bun macOS companion with adaptive Signal panel, floating beacon, native Settings, local Claude sessions and version-pinned review/library.",
      "entry_points": [
        "apps/desktop/src/main/index.ts",
        "apps/desktop/src/main/host.ts",
        "apps/desktop/src/main/shortcut.ts",
        "apps/desktop/src/native/shortcut.m",
